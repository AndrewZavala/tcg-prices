# Copy to .env and fill in values

TCG_ROOT=/opt/tcg
TZ=America/New_York

# Postgres (docker-compose defaults match these)
DATABASE_URL=postgresql://tcg:tcg_secret@localhost:5432/tcg_buylist
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcg_secret
POSTGRES_DB=tcg_buylist

# Pipeline schedule reference (set in cron on VPS)
PIPELINE_CRON=0 5 * * *
SCRYFALL_CRON=0 3 * * 0

# TCGplayer listing scrape (condition-aware buy prices)
# 0 = no product cap when screening is on; legacy top-N when OPPORTUNITY_USE_SCREENING=0
TCG_LISTINGS_MAX_PRODUCTS=0
TCG_LISTINGS_MAX_CASH_PRICE=0
TCG_LISTINGS_DELAY_SEC=0
# Preflight smoke test before full scrape (fail fast if CDP/API blocked)
TCG_LISTINGS_PREFLIGHT_COUNT=5
TCG_LISTINGS_PREFLIGHT_MIN_PRODUCTS=1
# Opportunity pipeline: screen full buylist with tcgcsv, live-scrape candidates only
OPPORTUNITY_USE_SCREENING=1
OPPORTUNITY_MIN_SCREEN_SPREAD=0.25
OPPORTUNITY_MIN_SCREEN_PCT=5
OPPORTUNITY_MIN_CK_CASH=0.50
OPPORTUNITY_SCREEN_MAX_CANDIDATES=0
OPPORTUNITY_TOP_N=0
OPPORTUNITY_SKIP_FETCH=0
TCG_BROWSER_CDP_URL=
TCG_BROWSER_CHANNEL=msedge
TCG_BROWSER_HEADLESS=0
TCG_BROWSER_LISTING_PAGE_SIZE=20
TCG_BROWSER_NAVIGATE_EACH=0
TCG_BROWSER_PROFILE_DIR=helper/tcgplayer-browser-profile

# Spell Tag (own Postgres + app on :8001 — separate from Manifest Bread)
# STAR_PIECE_PG_USER=starpiece
# STAR_PIECE_PG_PASSWORD=starpiece_secret
# STAR_PIECE_PG_DB=star_piece
# STAR_PIECE_PG_PORT=5433
# STAR_PIECE_CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
# SPELLTAG_PUBLIC_URL=http://localhost:8001
# Ingest: .\pipeline\run_pokemon_pipeline.ps1 -Series bw

# Google OAuth for Spell Tag (redirect: http://localhost:8001/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SPELLTAG_SESSION_SECRET=

# Pokémon TCG API — free key for subtype enrichment (dev.pokemontcg.io)
POKEMONTCG_API_KEY=

# TCGplayer affiliate (Impact) — Spell Tag buy links
# TCGPLAYER_PARTNER_ID=
# TCGPLAYER_AD_ID=
# TCGPLAYER_PARTNER_LINK=

# Web API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Production (see deploy/.env.production.example)
# SITE_DOMAIN=manifestbread.aizo.solutions
# ACME_EMAIL=you@aizo.solutions
