{
	email {$ACME_EMAIL}
}

# Spell Tag — public Pokémon TCG search (no basic auth)
{$SPELLTAG_DOMAIN:spelltag.com} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Self-hosted card art (Docker volume card_images → /srv/card-images)
	handle_path /media/* {
		root * /srv/card-images
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy star-piece:8001
}
