# Copy to repo root as .env on the VPS:
#   cp deploy/.env.production.example .env

TCG_ROOT=/opt/spelltag
TZ=America/New_York

# Spell Tag Postgres (compose service star-piece-db)
STAR_PIECE_PG_USER=starpiece
STAR_PIECE_PG_PASSWORD=CHANGE_ME
STAR_PIECE_PG_DB=star_piece

# Public site — Spell Tag
SPELLTAG_DOMAIN=spelltag.com
SPELLTAG_CORS_ORIGINS=https://spelltag.com,https://www.spelltag.com
SPELLTAG_PUBLIC_URL=https://spelltag.com
ACME_EMAIL=you@example.com

# Google OAuth (Console → Credentials → OAuth 2.0 Web client)
# Redirect URI must be: https://spelltag.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string for session cookies (openssl rand -hex 32)
SPELLTAG_SESSION_SECRET=

# Oracle tag permissions (comma-separated emails; admins can also tag)
SPELLTAG_ADMIN_EMAILS=
SPELLTAG_TAGGER_EMAILS=

# Optional: Pokémon TCG API key for subtype enrichment (dev.pokemontcg.io)
POKEMONTCG_API_KEY=

# Local card art mirror (Docker volume card_images)
CARD_IMAGE_ROOT=/data/card-images
