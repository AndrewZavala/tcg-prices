# Copy to repo root as .env on the VPS:
#   cp deploy/.env.production.example .env

TCG_ROOT=/opt/tcg
TZ=America/New_York

# Strong password — generate with: openssl rand -base64 32
POSTGRES_USER=tcg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tcg_buylist
DATABASE_URL=postgresql://tcg:CHANGE_ME@postgres:5432/tcg_buylist

# Public site
SITE_DOMAIN=manifestbread.aizo.solutions
ACME_EMAIL=you@aizo.solutions
CORS_ORIGINS=https://manifestbread.aizo.solutions

# Caddy basic auth (required for public GUI)
# Temporary bootstrap password is "password" — change ASAP:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_NEW_PASSWORD'
BASIC_AUTH_USER=andre
BASIC_AUTH_HASH=$2a$14$Z5UBXQtHue2.ndeHCJ6oqu.hx3Nw6Ho9Qjr1DNjCO7bIg16pN1pLm

# Cron (America/New_York)
PIPELINE_CRON=0 5 * * *
SCRYFALL_CRON=0 3 * * 0
