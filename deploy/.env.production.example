# Copy to repo root as .env on the VPS:
#   cp deploy/.env.production.example .env

TCG_ROOT=/opt/spelltag
TZ=America/New_York

# Spell Tag Postgres (compose service star-piece-db)
STAR_PIECE_PG_USER=starpiece
STAR_PIECE_PG_PASSWORD=CHANGE_ME
STAR_PIECE_PG_DB=star_piece

# Public site — Spell Tag
SPELLTAG_DOMAIN=spelltag.com
SPELLTAG_CORS_ORIGINS=https://spelltag.com,https://www.spelltag.com
ACME_EMAIL=you@example.com

# Optional: Pokémon TCG API key for subtype enrichment (dev.pokemontcg.io)
POKEMONTCG_API_KEY=
